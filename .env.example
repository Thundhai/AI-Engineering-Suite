# Public Supabase project settings — safe to expose in the client bundle.
# Find these in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: the Gemini API key is NOT set here and never ships to the browser.
# It is set once as a secret on the Supabase Edge Function — see SETUP.md.
